<Window x:Class="PdfElementsEditor.TextEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PdfElementsEditor"
        mc:Ignorable="d"
        Title="TextEditDialog" Height="450" Width="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Label Content="Text:" />
            <TextBox Name="TextBox" TextWrapping="Wrap" AcceptsReturn="True" Height="200" Width="400" Text="{Binding Text}" />
        </StackPanel>

        <Button Grid.Row="1" Name="OkButton" Content="OK" Click="OkButton_Click" Width="100" HorizontalAlignment="Right"  />

    </Grid>
</Window>
