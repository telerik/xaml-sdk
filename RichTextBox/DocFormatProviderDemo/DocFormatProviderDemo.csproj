<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <!-- zlibwapi.dll is a 32-bit native library -->
    <PlatformTarget>x86</PlatformTarget>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="DIaLOGIKa.b2xtranslator.CommonTranslatorLib, Version=1.0.0.0, Culture=neutral, PublicKeyToken=14be2f57e5013040, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>ThirdPartyLibrary\DIaLOGIKa.b2xtranslator.CommonTranslatorLib.dll</HintPath>
    </Reference>
    <Reference Include="DIaLOGIKa.b2xtranslator.DocFileFormat, Version=1.0.0.0, Culture=neutral, PublicKeyToken=14be2f57e5013040, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>ThirdPartyLibrary\DIaLOGIKa.b2xtranslator.DocFileFormat.dll</HintPath>
    </Reference>
    <Reference Include="DIaLOGIKa.b2xtranslator.OfficeDrawing, Version=1.0.0.0, Culture=neutral, PublicKeyToken=14be2f57e5013040, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>ThirdPartyLibrary\DIaLOGIKa.b2xtranslator.OfficeDrawing.dll</HintPath>
    </Reference>
    <Reference Include="DIaLOGIKa.b2xtranslator.OpenXmlLib, Version=1.0.0.0, Culture=neutral, PublicKeyToken=14be2f57e5013040, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>ThirdPartyLibrary\DIaLOGIKa.b2xtranslator.OpenXmlLib.dll</HintPath>
    </Reference>
    <Reference Include="DIaLOGIKa.b2xtranslator.StructuredStorage, Version=1.0.0.0, Culture=neutral, PublicKeyToken=14be2f57e5013040, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>ThirdPartyLibrary\DIaLOGIKa.b2xtranslator.StructuredStorage.dll</HintPath>
    </Reference>
    <Reference Include="DIaLOGIKa.b2xtranslator.Tools, Version=1.0.0.0, Culture=neutral, PublicKeyToken=14be2f57e5013040, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>ThirdPartyLibrary\DIaLOGIKa.b2xtranslator.Tools.dll</HintPath>
    </Reference>
    <Reference Include="DIaLOGIKa.b2xtranslator.WordprocessingMLMapping, Version=1.0.0.0, Culture=neutral, PublicKeyToken=14be2f57e5013040, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>ThirdPartyLibrary\DIaLOGIKa.b2xtranslator.WordprocessingMLMapping.dll</HintPath>
    </Reference>
    <Reference Include="DIaLOGIKa.b2xtranslator.ZipUtils, Version=1.0.0.0, Culture=neutral, PublicKeyToken=14be2f57e5013040, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>ThirdPartyLibrary\DIaLOGIKa.b2xtranslator.ZipUtils.dll</HintPath>
    </Reference>
    <PackageReference Include="Telerik.UI.for.Wpf.AllControls.Xaml" Version="*" />
  </ItemGroup>
  <ItemGroup>
    <AppDesigner Include="Properties\" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="ThirdPartyLibrary\DIaLOGIKa.b2xtranslator.CommonTranslatorLib.dll" />
    <Content Include="ThirdPartyLibrary\DIaLOGIKa.b2xtranslator.DocFileFormat.dll" />
    <Content Include="ThirdPartyLibrary\DIaLOGIKa.b2xtranslator.OfficeDrawing.dll" />
    <Content Include="ThirdPartyLibrary\DIaLOGIKa.b2xtranslator.OpenXmlLib.dll" />
    <Content Include="ThirdPartyLibrary\DIaLOGIKa.b2xtranslator.StructuredStorage.dll" />
    <Content Include="ThirdPartyLibrary\DIaLOGIKa.b2xtranslator.Tools.dll" />
    <Content Include="ThirdPartyLibrary\DIaLOGIKa.b2xtranslator.WordprocessingMLMapping.dll" />
    <Content Include="ThirdPartyLibrary\DIaLOGIKa.b2xtranslator.ZipUtils.dll" />
    <Content Include="zlibwapi.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="SampleData\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
